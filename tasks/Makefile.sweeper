# Sweeper targets: the Azure timer function in sweeper/azure and the AWS Lambda function in sweeper/aws. Python tools run through uv, which mise pins.

# The folder that holds the Function App and its pyproject.toml.
SWEEPER_DIR ?= sweeper/azure
SWEEPER_UV ?= $(MISE_EXEC) uv --directory $(SWEEPER_DIR) run --locked

.PHONY: sweeper/lint
## Check the sweeper code with ruff: lint rules and format
sweeper/lint:
	$(SWEEPER_UV) ruff check .
	$(SWEEPER_UV) ruff format --check .

# The AWS sweeper: the Lambda function in sweeper/aws (spec 0013). Same tools, its own project.
SWEEPER_AWS_DIR ?= sweeper/aws
SWEEPER_AWS_UV ?= $(MISE_EXEC) uv --directory $(SWEEPER_AWS_DIR) run --locked

.PHONY: sweeper/aws/lint
## Check the AWS sweeper code with ruff: lint rules and format
sweeper/aws/lint:
	$(SWEEPER_AWS_UV) ruff check .
	$(SWEEPER_AWS_UV) ruff format --check .
