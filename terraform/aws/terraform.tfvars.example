# Settings of the AWS stack. Every value in this file is made up.
#
# 1. Copy this file to terraform.tfvars in the same folder:
#      cp terraform.tfvars.example terraform.tfvars
# 2. Replace every value with your own.
# 3. Never commit terraform.tfvars. Git ignores it.
#
# OpenTofu reads terraform.tfvars by itself. Each variable is in variables.tf.
# Credentials come from your own AWS CLI login, never from this file.

# The AWS Region of the stack. The default is us-east-1.
region = "us-east-1"

# Required. Your existing VPC in that Region. The stack creates no VPC.
vpc_id = "vpc-00000000000000000"

# Required. Your existing subnet in that VPC. Its zone must offer instance_type.
subnet_id = "subnet-00000000000000000"

# The experiment file, relative to this folder. Its experiment: key holds a dated name,
# for example ftg-20260101-example.
targets_file = "../../config/targets.yaml"

# Extra tags on each resource, for example the tags that a tag policy needs.
tags = { owner = "example-team" }

# Optional. Email address for the sweeper-stopped alarm. Empty means no alarm.
# alert_email = "alerts@example.com"

# Consent: true lets the stack grant the rights to create billable capacity. Keep it false.
grant_billable_provisioning = false

# Set true only when the subnet has no internet path: it adds an S3 gateway endpoint.
enable_s3_gateway_endpoint = false

# Optional. An HTTP egress proxy: a host name and a port, no IP address.
# egress_proxy_url = "http://proxy.example.com:3128"

# Optional. Extra hosts that bypass the proxy.
# no_proxy = [".example.com"]

# Optional. Existing security groups to add to the prober VM.
# vpc_security_group_ids = ["sg-00000000000000000"]

# Optional. The size of the prober VM. The default is t4g.small (arm64).
# instance_type = "t4g.small"

# Optional. Prefix of each resource name. The default is ftg.
# name_prefix = "ftg"
