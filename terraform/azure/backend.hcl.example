# Optional: keep the OpenTofu state of the Azure stack in a blob container. Every value is made up.
# Without this file, the state is a local file in this folder (terraform.tfstate).
#
# 1. Make the storage account and the container first, and turn on blob versioning.
# 2. Copy this file to backend.hcl in the same folder, and replace every value with your own:
#      cp backend.hcl.example backend.hcl
# 3. The stack has no backend block, so add one in a file of its own. Make
#    backend_override.tf in the same folder with this content:
#      terraform {
#        backend "azurerm" {}
#      }
# 4. Run: tofu -chdir=terraform/azure init -backend-config=backend.hcl
#    make plan/azure also passes -backend-config=backend.hcl when the file exists.
#
# Git ignores backend.hcl and backend_override.tf. Never commit them.

subscription_id      = "00000000-0000-0000-0000-000000000000"
resource_group_name  = "example-state-rg"
storage_account_name = "examplestate0000"
container_name       = "tfstate"
key                  = "ftg-20260101-example/azure.tfstate"
use_azuread_auth     = true
