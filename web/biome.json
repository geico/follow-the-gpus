{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!sample", "!dist", "!test/fixtures"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": ["src/board/derive/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react-dom",
                      "react/*",
                      "react-dom/*",
                      "@radix-ui/*",
                      "**/view/**",
                      "**/components/**",
                      "**/server/**",
                      "**/data/**",
                      "node:*",
                      "@duckdb/*"
                    ],
                    "message": "The derive layer imports no React, DOM, component, data client, or server code (spec 0006 section 10.3)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
