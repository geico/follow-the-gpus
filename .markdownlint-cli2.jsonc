{
  // Markdown style checks for the pre-commit hook. Rules that clash with this repo's style are off.
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD025": { "front_matter_title": "" },
    "MD033": false,
    "MD041": false,
    "MD060": false
  },
  "ignores": ["node_modules/**"]
}
